{
  "expo": {
    "name": "Upande Livestock",
    "slug": "upande-livestock",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/upande_logo_no_bg.png",
    "scheme": "upandelivestock",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://kaitet.132.145.18.63.nip.io/api/method/upande_mobile.api.ota.manifest?app=Upande%20Livestock"
    },
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/upande_logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stivewithani.upandelivestock"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/upande_logo_no_bg.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Upande Livestock uses the camera to photograph a newborn calf so the picture lands on the animal's record.",
          "photosPermission": "Upande Livestock needs access to your photos only if you choose an existing picture instead of taking one."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      "@upande/mobile-kit",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": "1.1.0-kaitetdairyfrappe16",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0640a515-d7f3-4710-a550-8cf6b8934b7e"
      },
      "otaBaseUrl": "https://upandeltd.github.io/upande-livestock-kaitet-releases/ota",
      "mobileKit": {
        "_help": "All of the kit's settings for this app live here. Edit the lists under \"release\"; the kit manages nativeBaseline and apkTag itself.",
        "sites": {
          "production": "https://kaitet.132.145.18.63.nip.io"
        },
        "versionCodeBase": 0,
        "runtimeMajorBase": 0,
        "release": {
          "_help": "Decides APK or OTA for you. \"apk\": folders/files (globs) that need a new APK when they change, e.g. \"modules/**\". \"ota\": folders/files that are safe over the air, e.g. \"assets/fonts/**\". Built in: app/**, src/**, tests, docs, *.md are OTA; android/**, ios/**, patches/**, plugins/** are APK. A changed file in neither list builds an APK to be safe, and the release says which file to list.",
          "apk": [],
          "ota": []
        }
      }
    }
  }
}
