{
  "expo": {
    "name": "Upande Livestock Mutara",
    "slug": "upande-livestock-mutara",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/upande_logo_no_bg.png",
    "scheme": "upandelivestockmutara",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f6f49a81-310e-4c2d-a446-6641bfc3e0c9"
    },
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.upande.livestockmutara"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/upande_logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.upande.livestockmutara",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/upande_logo_no_bg.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Upande Livestock Mutara uses the camera to photograph a newborn calf so the picture lands on the animal's record.",
          "photosPermission": "Upande Livestock Mutara needs access to your photos only if you choose an existing picture instead of taking one."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": "1.1.0-mutarabeeffrappe16",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6f49a81-310e-4c2d-a446-6641bfc3e0c9"
      }
    },
    "owner": "stivewithani"
  }
}
